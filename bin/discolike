#!/bin/sh
# Runs the DiscoLike CLI at the version this plugin pins in `cli-version`, via
# uvx, so every session gets the same CLI regardless of what is on PATH. Put
# this directory on PATH (the `setup` skill does) or call it by absolute path.
#
# Failures use the CLI's own contract: JSON error envelope on stderr, exit 5
# for a missing runtime, so an agent branching on exit codes sees one shape.
set -eu

die() {
  msg=$(printf '%s' "$2" | sed 's/\\/\\\\/g; s/"/\\"/g')
  printf '{"error":"LauncherError","code":"%s","message":"%s","status_code":null,"exit_code":%s}\n' "$1" "$msg" "$3" >&2
  exit "$3"
}

self="$0"
case "$self" in
  */*) ;;
  *) self="$(command -v -- "$self")" || die internal_error "discolike launcher: cannot resolve its own path" 1 ;;
esac
bin_dir="$(cd -- "$(dirname -- "$self")" && pwd)"

version_file="$bin_dir/cli-version"
[ -f "$version_file" ] || die internal_error "discolike launcher: missing $version_file (reinstall the DiscoLike plugin)" 1
version="$(tr -d '[:space:]' < "$version_file")"
[ -n "$version" ] || die internal_error "discolike launcher: empty $version_file" 1

if command -v uvx > /dev/null 2>&1; then
  exec uvx --quiet --from "discolike-cli==$version" discolike "$@"
fi
if command -v uv > /dev/null 2>&1; then
  exec uv tool run --quiet --from "discolike-cli==$version" discolike "$@"
fi
die network_error "discolike launcher: uv is not installed. Install it with: curl -LsSf https://astral.sh/uv/install.sh | sh  (or: pip install uv), then retry." 5
